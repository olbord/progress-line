spring.application.name=veebirakenduse-projekt

spring.datasource.url=jdbc:postgresql://postgres:5432/postgres
spring.datasource.username=ADD USERNAME HERE, DONT PUSH TO GIT
spring.datasource.password=ADD PASSWORD HERE, DONT PUSH TO GIT
spring.datasource.driver-class-name=org.postgresql.Driver

spring.liquibase.change-log= classpath:/db/changelog/changelog-master.xml

logging.level.org.root=INFO
logging.level.org.springframework=WARN
logging.level.org.springframework.web=DEBUG
logging.level.org.springframework.security=DEBUG
logging.level.org.postgresql=DEBUG

# Show SQL statements
spring.jpa.show-sql=true

# Format SQL for readability
spring.jpa.properties.hibernate.format_sql=true

# Show binding parameters
logging.level.org.hibernate.type.descriptor.sql=trace

# General email account
spring.mail.host=mail.jairus.ee
spring.mail.port=587
spring.mail.username=noreply@jairus.ee
spring.mail.password=ADD PASSWORD HERE, DONT PUSH TO GIT
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

